        <mxCell id="cb6bSvUKwpR6El5IvKav-3" value="Didn&#39;t accept the Free Bet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="WIyWlLk6GJQsqaUBKTNV-1">
